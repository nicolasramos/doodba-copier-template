#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# setup-odooclaw.sh - Bootstrap OdooClaw configuration for a Doodba project
#
# This script is generated by doodba-copier-template when use_odooclaw=true.
# It validates the configuration files that the template already generated
# and prints next-step instructions. It does NOT create config.json from
# scratch, because the template renders it directly into the project tree
# (see template/odooclaw/config/config.json.jinja).
# ---------------------------------------------------------------------------
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_TARGET="$ROOT_DIR/odooclaw/config/config.json"
ODOO_ENV_TARGET="$ROOT_DIR/.docker/odoo.env"

echo "Bootstrapping OdooClaw..."

# Validate config.json exists (template renders it directly)
if [ ! -f "$CONFIG_TARGET" ]; then
  echo "ERROR: Missing $CONFIG_TARGET" >&2
  echo "The template should generate this file when use_odooclaw=true." >&2
  echo "Re-run the copier template or check your .copier-answers.yml." >&2
  exit 1
fi
echo "[OK] odooclaw/config/config.json present"

# Validate .docker/odoo.env exists and has the required OdooClaw vars
if [ ! -f "$ODOO_ENV_TARGET" ]; then
  echo "WARNING: $ODOO_ENV_TARGET not found."
  echo "Copy .docker/odoo_env.sample to .docker/odoo.env before starting the stack."
else
  if ! grep -qE '^ODOOCLAW_CHANNELS_ODOO_ENABLED=' "$ODOO_ENV_TARGET"; then
    echo "WARNING: ODOOCLAW_CHANNELS_ODOO_ENABLED is missing from $ODOO_ENV_TARGET."
    echo "Add the OdooClaw env block (see README.md OdooClaw section)."
  else
    echo "[OK] OdooClaw env block present in .docker/odoo.env"
  fi
  if ! grep -qE '^OPENAI_API_KEY=' "$ODOO_ENV_TARGET"; then
    echo "WARNING: OPENAI_API_KEY is not set in $ODOO_ENV_TARGET."
    echo "OdooClaw needs an LLM provider API key to operate."
  fi
fi

echo ""
echo "OdooClaw bootstrap completed."
echo "Next steps:"
echo "  1) Edit .docker/odoo.env with your API keys (OPENAI_API_KEY, etc.)"
echo "  2) Start the stack: invoke start"
echo "  3) Verify health: scripts/smoke-test-odooclaw.sh"
