#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# setup-odooclaw.sh - Bootstrap OdooClaw configuration for a Doodba project
#
# This script is generated by doodba-copier-template when use_odooclaw=true.
# It creates the initial config files and validates prerequisites.
# ---------------------------------------------------------------------------
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_EXAMPLE="$ROOT_DIR/odooclaw/config/config.example.json"
CONFIG_TARGET="$ROOT_DIR/odooclaw/config/config.json"
ODOO_ENV_TARGET="$ROOT_DIR/.docker/odoo.env"

echo "Bootstrapping OdooClaw..."

# Create config.json from example if not exists
if [ ! -f "$CONFIG_EXAMPLE" ]; then
  echo "ERROR: Missing $CONFIG_EXAMPLE" >&2
  exit 1
fi
if [ ! -f "$CONFIG_TARGET" ]; then
  cp "$CONFIG_EXAMPLE" "$CONFIG_TARGET"
  echo "Created odooclaw/config/config.json from config.example.json"
else
  echo "config.json already exists, keeping current file"
fi

# Validate .docker/odoo.env exists
if [ ! -f "$ODOO_ENV_TARGET" ]; then
  echo "WARNING: .docker/odoo.env not found."
  echo "Edit it with your API keys before starting the stack."
fi

echo "OdooClaw bootstrap completed."
echo "Next steps:"
echo "  1) Edit .docker/odoo.env with your API keys"
echo "  2) Run: invoke start"
