#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# smoke-test-odooclaw.sh - Basic health check for OdooClaw gateway
#
# This script is generated by doodba-copier-template when use_odooclaw=true.
# ---------------------------------------------------------------------------
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Running OdooClaw smoke test..."

# Check if the odooclaw container is running
if docker compose ps odooclaw 2>/dev/null | grep -q "Up"; then
  echo "[OK] odooclaw container is running"
else
  echo "[WARN] odooclaw container is not running"
  echo "  Start the stack first: invoke start"
  exit 1
fi

# Health check via gateway endpoint
HEALTH_URL="http://localhost:18790/health"
if curl -sf "$HEALTH_URL" > /dev/null 2>&1; then
  echo "[OK] OdooClaw gateway health check passed"
else
  echo "[WARN] OdooClaw gateway not responding at $HEALTH_URL"
  echo "  The container may still be starting up."
  echo "  Check logs: docker compose logs odooclaw"
fi

echo "Smoke test completed."
