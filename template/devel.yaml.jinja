{%- import "macros/_macros.jinja" as macros -%}
{% set whitelisted_hosts = whitelisted_hosts_devel | default([]) -%}
{% if compose_version == "v1" %}
version: "2.4"

{% endif %}
services:
  odoo_proxy:
    image: ghcr.io/tecnativa/docker-whitelist:latest
    depends_on:
      - odoo
    networks: &public
      default:
      public:
    ports:
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }899:6899"
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }069:8069"
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }072:8072"
    environment:
      PORT: "6899 8069 8072"
      TARGET: odoo

  odoo:
    extends:
      file: common.yaml
      service: odoo
    build:
      args:
        # To aggregate in development, use `setup-devel.yaml`
        AGGREGATE: "false"
        # Export these variables to own files created by odoo in your filesystem
        UID: "${UID:-1000}"
        GID: "${GID:-1000}"
        # No need for this in development
        PIP_INSTALL_ODOO: "false"
        CLEAN: "false"
        COMPILE: "false"
    environment:
      DOODBA_ENVIRONMENT: "${DOODBA_ENVIRONMENT-devel}"
      INITIAL_LANG: "{{ odoo_initial_lang }}"
      LIST_DB: "true"
      DEBUGPY_ENABLE: "${DOODBA_DEBUGPY_ENABLE:-0}"
      PGDATABASE: &dbname devel
      PYDEVD_RESOLVE_SYMLINKS: 1
      PYTHONDONTWRITEBYTECODE: 1
      PYTHONOPTIMIZE: ""
      PYTHONPATH: /opt/odoo/custom/src/odoo
      SMTP_PORT: "1025"
      {%- if whitelisted_hosts %}
      WDB_SOCKET_SERVER: "wdb_internal"
      {%- endif %}
      WDB_WEB_PORT: "${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }984"
      # To avoid installing demo data export DOODBA_WITHOUT_DEMO=all
      WITHOUT_DEMO: "${DOODBA_WITHOUT_DEMO-false}"
    volumes:
      - ./odoo/custom:/opt/odoo/custom:ro,z
      - ./odoo/auto:/opt/odoo/auto:rw,z
    depends_on:
      - db
      - smtp
      - wdb
      {%- if whitelisted_hosts %}
      - proxy_general
      {%- endif %}
    {%- if whitelisted_hosts %}
    networks:
      default:
      whitelist:
    {%- endif %}
    command:
      - odoo
      - --limit-memory-soft=0
      {%- if odoo_version >= 10 %}
      - --limit-time-real-cron=9999999
      {%- endif %}
      - --limit-time-real=9999999
      - --workers=0
      {%- if odoo_version == 9 %}
      - --dev
      {%- elif odoo_version >= 10 and odoo_version < 19 %}
      - --dev=reload,qweb,werkzeug,xml
      {%- else %}
      - --dev=reload,qweb,werkzeug,xml,access
      {%- endif %}

  {% if postgres_version -%}
  db:
    extends:
      file: common.yaml
      service: db
    environment:
      POSTGRES_DB: *dbname
      POSTGRES_PASSWORD: odoopassword
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -q -d $$POSTGRES_DB -U $$POSTGRES_USER"]
      interval: 5s
      timeout: 5s
      retries: 5
  {%- endif %}

  pgweb:
    image: docker.io/sosedoff/pgweb
    networks: *public
    ports:
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }081:8081"
    environment:
      PGWEB_DATABASE_URL: postgres://{{ postgres_username }}:odoopassword@db:5432/devel?sslmode=disable
    depends_on:
      db:
        condition: service_healthy

  smtp:
    extends:
      file: common.yaml
      service: smtpfake
    networks: *public
    ports:
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }025:8025"

  wdb:
    image: docker.io/kozea/wdb
{%- if whitelisted_hosts %}
    networks:
      default:
        aliases:
          - wdb_internal
      public:
{%- else %}
    networks: *public
{%- endif %}
    ports:
      - "127.0.0.1:${PORT_PREFIX:-{{ macros.version_major(odoo_version) -}} }984:1984"
    # HACK https://github.com/Kozea/wdb/issues/136
    init: true

  {% if use_odooclaw and odoo_version >= 16.0 and odoo_version <= 18.0 -%}
  odooclaw:
    image: docker.io/nicolasramos/odooclaw:latest
    restart: unless-stopped
    env_file:
      - .docker/odoo.env
    environment:
      ODOO_URL: http://odoo:8069
      ODOO_DB: ${ODOO_DB:-devel}
      ODOO_USERNAME: ${ODOO_USERNAME:-admin}
      ODOO_PASSWORD: ${ODOO_PASSWORD:-admin}
      HTTP_PROXY: ""
      HTTPS_PROXY: ""
      ALL_PROXY: ""
      NO_PROXY: "localhost,127.0.0.1,odoo,redis,db"
      ODOOCLAW_AGENTS_DEFAULTS_PROVIDER: ${ODOOCLAW_AGENTS_DEFAULTS_PROVIDER:-openai}
      ODOOCLAW_AGENTS_DEFAULTS_MODEL: ${ODOOCLAW_AGENTS_DEFAULTS_MODEL:-gpt-4o-mini}
      ODOOCLAW_PROVIDERS_OPENAI_API_KEY: ${OPENAI_API_KEY}
      ODOOCLAW_PROVIDERS_OPENAI_API_BASE: ${OPENAI_API_BASE:-https://api.openai.com/v1}
      ODOOCLAW_CHANNELS_ODOO_ENABLED: "true"
      ODOOCLAW_CHANNELS_ODOO_WEBHOOK_HOST: 0.0.0.0
      ODOOCLAW_CHANNELS_ODOO_WEBHOOK_PORT: 18790
      ODOOCLAW_CHANNELS_ODOO_WEBHOOK_PATH: /webhook/odoo
      ODOOCLAW_REDIS_URL: redis://redis:6379/0
      ODOOCLAW_JOB_STORE: odoo
    ports:
      - "18790:18790"
    volumes:
      - odooclaw_data:/home/odooclaw/.odooclaw
      - ./odooclaw/config/config.json:/home/odooclaw/.odooclaw/config.json:ro
    depends_on:
      - odoo
      - redis
    networks:
      - default

  redis:
    image: redis:7-alpine
    command: redis-server --appendonly yes
    restart: unless-stopped
    networks:
      - default
  {% endif %}
{%- if whitelisted_hosts %}

  odoo_net_setup:
    image: ghcr.io/tecnativa/docker-whitelist-gateway-service:edge
    network_mode: "service:odoo"
    cap_add:
      - NET_ADMIN
    depends_on:
      - odoo
      - proxy_general
    healthcheck:
      disable: true
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      MODE_RUN: "net_setup"
      GATEWAY_NAME: "proxy_general"
      DNS_LOCAL: "1"
      DNS_INTERNAL_FROM_DOCKER: "1"
      DOCKER_PROJECT: "${COMPOSE_PROJECT_NAME:-{{ whitelist_docker_project_devel }}}"
      DOCKER_PRIMARY_SERVICE: "odoo"
      ALLOWED_HOSTS: &proxy_allowed_hosts >-
        {{ whitelisted_hosts | join(" ") }}

  proxy_general:
    image: ghcr.io/tecnativa/docker-whitelist-gateway-service:edge
    cap_add:
      - NET_ADMIN
    sysctls:
      net.ipv4.ip_forward: "1"
    networks:
      whitelist:
        aliases:
          - proxy_general
      public:
    environment:
      MODE_RUN: "gateway"
      ALLOWED_HOSTS: *proxy_allowed_hosts

{%- endif %}
networks:
  default:
    internal: ${DOODBA_NETWORK_INTERNAL-true}
  public:
{%- if whitelisted_hosts %}
  whitelist:
{%- endif %}

volumes:
  filestore:
  db:
  {%- if use_odooclaw and odoo_version >= 16.0 and odoo_version <= 18.0 %}
  odooclaw_data:
  {%- endif %}
